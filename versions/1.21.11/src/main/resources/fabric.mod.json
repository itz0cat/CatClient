{
	"schemaVersion": 1,
	"id": "catclient",
	"version": "${version}",
	"name": "CatClient",
	"description": "CatClient — Modern PvP and utility client mod for Minecraft Fabric 1.21.11. Forked from AxolotlClient. Special thanks to moehreag and the original team for creating the original client!",
	"authors": [
		"itz0cat"
	],
	"contributors": [
		"AxolotlClient Team (Original Client - Special Thanks!)"
	],
	"contact": {
		"homepage": "https://github.com/itz0cat/CatClient",
		"sources": "https://github.com/itz0cat/CatClient",
		"issues": "https://github.com/itz0cat/CatClient/issues"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/catclient/icon.png",
	"accessWidener": "catclient.classtweaker",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.axolotlclient.AxolotlClient"
		],
		"modmenu": [
			"io.github.axolotlclient.config.modmenu.ModMenuCompat"
		],
		"worldhost": [
			"io.github.axolotlclient.api.worldhost.AxolotlClientWorldHostPlugin"
		]
	},
	"mixins": [
		"catclient.mixins.json",
		"catclient-bridge.mixins.json",
		"catclient.e4mc.mixins.json"
	],
	"custom": {
		"catclient:bridge_impl_version": "V1_21_11"
	},
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": "1.21.11",
		"fabric-api": "*",
		"axolotlclientconfig": "*",
		"catclient-common": "*"
	}
}
